@model MyKicksBuddy.Models.Dtos.LoginRequest
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Masuk";
}

<section class="auth-shell" aria-labelledby="loginTitle">
    <div class="auth-intro auth-visual auth-visual-login">
        <div class="auth-visual-copy">
            <p class="auth-eyebrow">AKUN MYKICKSBUDDY</p>
            <h1 id="loginTitle">Selamat datang <span>kembali</span></h1>
            <p>Masuk untuk melanjutkan perawatan sepatumu.</p>
            <p class="auth-visual-phrase">Rawat. Pantau. Kembali Melangkah.</p>
        </div>
        <figure class="auth-shoe-stage" aria-hidden="true">
            <img class="auth-shoe-image" src="~/images/landing/hero-shoe-side.png" alt="" />
        </figure>
    </div>

    <form class="auth-form" action="/auth/login" method="post" data-auth-form="login" data-customer-url="@Url.Action("Index", "Customer")" data-staff-url="@Url.Action("Index", "Staff")" data-admin-url="@Url.Action("Index", "Admin")" novalidate>
        @Html.AntiForgeryToken()
        <div class="auth-form-heading">
            <h2>Masuk ke akun</h2>
            <p>Gunakan email atau nomor ponsel yang terdaftar.</p>
        </div>
        <div class="auth-alert" role="alert" aria-live="polite" data-form-alert hidden></div>

        <div class="auth-field">
            <label for="EmailOrPhone">Email atau nomor ponsel</label>
            <input id="EmailOrPhone" name="EmailOrPhone" type="text" autocomplete="username" required aria-describedby="EmailOrPhoneError" />
            <span class="auth-field-error" id="EmailOrPhoneError" data-error-for="EmailOrPhone"></span>
        </div>

        <div class="auth-field">
            <label for="LoginPassword">Password</label>
            <div class="password-control">
                <input id="LoginPassword" name="Password" type="password" autocomplete="current-password" required aria-describedby="PasswordError" />
                <button type="button" class="password-toggle" data-password-toggle="LoginPassword" aria-label="Tampilkan kata sandi" aria-pressed="false">
                    <svg class="eye-open" aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                    <svg class="eye-closed" aria-hidden="true" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.2A10 10 0 0 1 12 6c6 0 9.5 6 9.5 6a16 16 0 0 1-2.1 2.7M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a10 10 0 0 0 3-.5M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                </button>
            </div>
            <span class="auth-field-error" id="PasswordError" data-error-for="Password"></span>
        </div>

        <button class="auth-submit" type="submit" data-submit-button>
            <span class="auth-spinner" aria-hidden="true"></span>
            <span data-submit-label>Masuk</span>
        </button>

        <p class="auth-switch">Belum punya akun? <a href="/auth/register">Buat akun</a></p>
    </form>
</section>
