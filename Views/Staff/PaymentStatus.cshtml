@model MyKicksBuddy.Models.Dtos.StaffPaymentRow
@using MyKicksBuddy.Services
@using System.Globalization
@{ Layout = "_StaffLayout"; ViewData["Title"] = "Status Pembayaran"; ViewData["StaffSection"] = "payments"; var culture = CultureInfo.GetCultureInfo("id-ID"); var label = StaffPaymentPresentation.Label(Model.PaymentStatus, Model.Provider is not null); }
<a class="staff-detail-back" asp-action="Payments">← Kembali ke manajemen pembayaran</a><div class="staff-page-heading"><div><p class="staff-kicker">PEMBAYARAN / @Model.OrderCode</p><h1 class="staff-page-title">Status Pembayaran</h1><p class="staff-page-intro">Informasi status pembayaran dari database, tanpa simulasi konfirmasi.</p></div><span class="staff-badge @StaffPaymentPresentation.Tone(Model.PaymentStatus)">@label</span></div>
<div class="staff-payment-status-grid"><section class="staff-card staff-payment-status-main"><p class="staff-kicker">TOTAL PEMBAYARAN</p><div class="staff-payment-amount">@Model.TotalAmount.ToString("C0", culture)</div><h2>@label</h2><p class="staff-card-subtitle">@if (Model.PaymentStatus == PaymentStatusWorkflow.Paid) { <span>Pembayaran tercatat terverifikasi pada data pesanan.</span> } else { <span>Pembayaran belum tercatat sebagai terverifikasi. Staff tidak dapat mengubahnya dari halaman ini.</span> }</p><div class="staff-profile-details"><div><span>Kode pesanan</span><strong>@Model.OrderCode</strong></div><div><span>Provider</span><strong>@(Model.Provider ?? "Belum terhubung")</strong></div><div><span>Referensi provider</span><strong>@(Model.ProviderReference ?? "Belum tersedia")</strong></div><div><span>Status pesanan</span><strong>@OrderStatusWorkflow.DisplayLabel(Model.OrderStatus, Model.PaymentStatus)</strong></div>@if (Model.VerifiedAt.HasValue) { <div><span>Waktu terverifikasi</span><strong>@Model.VerifiedAt.Value.ToString("dd MMM yyyy, HH:mm", culture)</strong></div> }</div><p class="staff-note is-warning">QRIS, transfer, verifikasi manual, dan tombol berhasil tidak ditampilkan karena provider pembayaran belum dikonfigurasi.</p></section><aside class="staff-detail-column"><section class="staff-card"><h2>Ringkasan Pesanan</h2><dl class="staff-detail-dl"><div><dt>Pelanggan</dt><dd>@Model.CustomerName</dd></div><div><dt>Layanan</dt><dd>@(Model.ServiceName ?? "—")</dd></div><div><dt>Dibuat</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm", culture)</dd></div><div><dt>Total</dt><dd>@Model.TotalAmount.ToString("C0", culture)</dd></div></dl><a class="staff-btn staff-btn-light" asp-action="Detail" asp-route-id="@Model.OrderId">Lihat Pesanan →</a></section><section class="staff-card"><h2>Bantuan</h2><p class="staff-card-subtitle">Jika pelanggan melaporkan sudah membayar tetapi status belum berubah, jangan lakukan konfirmasi manual. Hubungi pengelola integrasi pembayaran.</p></section></aside></div>
