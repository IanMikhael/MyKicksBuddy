@model MyKicksBuddy.Models.Dtos.OrderDetailPageViewModel
@using MyKicksBuddy.Services
@using System.Globalization
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Detail & Ubah Status Pesanan";
    ViewData["StaffSection"] = "orders";
    var o = Model.Order;
    var culture = CultureInfo.GetCultureInfo("id-ID");
}
<a class="staff-detail-back" asp-action="Orders">← Kembali ke Antrean Pesanan</a>
<section class="staff-detail-hero staff-card"><div><p class="staff-kicker">KODE PESANAN · @o.OrderCode</p><h1>@o.OrderCode</h1><p>@o.CustomerName · @(o.CustomerPhone ?? o.CustomerEmail ?? "Kontak belum tersedia")</p><p class="staff-detail-hero-sub">@(o.Items.FirstOrDefault()?.ServiceName ?? "Layanan perawatan") · @o.CreatedAt.ToString("dd MMM yyyy, HH:mm", culture)</p></div><div class="staff-detail-hero-actions"><span class="staff-badge">@o.StatusLabel</span><a class="staff-btn staff-btn-primary" href="#status-operasional">Ubah Status Operasional →</a></div></section>
@if (TempData["Success"] is string success) { <p class="staff-note" role="status">@success</p> }
@if (TempData["Error"] is string error) { <p class="staff-note is-danger" role="alert">@error</p> }
<div class="staff-detail-grid"><div class="staff-detail-column">
    <section class="staff-card"><div class="staff-section-head staff-detail-section-head"><div><h2>Informasi Perawatan &amp; Sepatu</h2><p class="staff-card-subtitle">Spesifikasi barang masuk dan detail teknis yang tersedia.</p></div><span class="staff-badge is-neutral">@o.Items.Sum(x => x.Quantity) UNIT</span></div><div class="staff-detail-section-body">@foreach (var item in o.Items) { <div class="staff-detail-item"><img src="~/images/landing/service-cleaning.png" alt="Ilustrasi layanan perawatan sepatu" /><div><small>KATALOG LAYANAN</small><strong>@item.ServiceName</strong><small>@item.ShoeDescription</small><small>@item.Quantity pasang × @item.Price.ToString("C0", culture)</small><b>@item.Subtotal.ToString("C0", culture)</b></div></div> }@if (!string.IsNullOrWhiteSpace(o.Notes)) { <div class="staff-note staff-detail-customer-note"><strong>Catatan Pelanggan</strong><br />@o.Notes</div> }</div></section>
    <section class="staff-card"><div class="staff-section-head staff-detail-section-head"><div><h2>Lokasi &amp; Logistik Penjemputan</h2><p class="staff-card-subtitle">Informasi lokasi dan cara penyerahan yang tercatat.</p></div></div><div class="staff-detail-section-body"><dl class="staff-detail-dl"><div><dt>Metode penyerahan</dt><dd>@(o.FulfillmentType == "pickup_delivery" ? "Antar-jemput" : "Drop off")</dd></div><div><dt>Pelanggan</dt><dd>@o.CustomerName</dd></div><div><dt>Kontak</dt><dd>@(o.CustomerPhone ?? o.CustomerEmail ?? "—")</dd></div><div><dt>Alamat penjemputan</dt><dd>@(o.FullAddress ?? "Tidak ada alamat penjemputan")</dd></div></dl><p class="staff-note">Jadwal pickup, kurir, dan peta live belum tersedia dari backend. Tidak ada estimasi lokasi yang ditampilkan.</p></div></section>
    <section class="staff-card"><div class="staff-section-head staff-detail-section-head"><div><h2>Riwayat Perubahan Status Operasional</h2><p class="staff-card-subtitle">Jejak audit tahapan pesanan yang tercatat.</p></div><span class="staff-badge is-neutral">@Model.Logs.Count peristiwa</span></div><div class="staff-detail-section-body">@if (!Model.Logs.Any()) { <p class="staff-dim">Belum ada riwayat perubahan status.</p> } else { <ol class="staff-timeline">@foreach (var log in Model.Logs.OrderByDescending(x => x.CreatedAt)) { <li><strong>@OrderStatusWorkflow.Label(log.Status)</strong><time>@log.CreatedAt.ToString("dd MMM yyyy, HH:mm", culture)</time>@if (!string.IsNullOrWhiteSpace(log.Note)) { <p>@log.Note</p> }</li> }</ol> }</div></section>
</div><aside class="staff-detail-column">
    <section id="status-operasional" class="staff-card"><h2>Perbarui Status Pesanan</h2><p class="staff-card-subtitle">Ubah alur pengerjaan hanya ke langkah yang sah, lalu beri catatan operasional.</p><p class="staff-note">Status saat ini: <strong>@o.StatusLabel</strong></p>@if (Model.AllowedStatuses.Any()) { @foreach (var status in Model.AllowedStatuses) { <form class="staff-status-form" asp-action="UpdateStatus" asp-route-id="@o.Id" method="post"><input type="hidden" name="status" value="@status" /><label class="staff-field">Catatan operasional (opsional)<textarea class="staff-textarea" name="notes" maxlength="1000" placeholder="Contoh: proses yang benar-benar telah dilakukan..."></textarea></label><button class="staff-btn @(status == OrderStatusWorkflow.Cancelled ? "staff-btn-light" : "staff-btn-primary")" type="submit">@(status == OrderStatusWorkflow.Cancelled ? "Batalkan Pesanan" : "Simpan: " + OrderStatusWorkflow.Label(status)) →</button></form> } } else { <p class="staff-note is-warning">Tidak ada transisi operasional yang sah dari status dan pembayaran saat ini.</p> }</section>
    <section class="staff-card"><h2>Status Pembayaran &amp; Transaksi</h2><dl class="staff-detail-dl"><div><dt>Status pembayaran</dt><dd>@StaffPaymentPresentation.Label(o.PaymentStatus, false)</dd></div><div><dt>Subtotal layanan</dt><dd>@o.Subtotal.ToString("C0", culture)</dd></div><div><dt>Total pembayaran</dt><dd>@o.TotalAmount.ToString("C0", culture)</dd></div></dl><a class="staff-btn staff-btn-light" asp-action="PaymentStatus" asp-route-orderId="@o.Id">Lihat Detail Pembayaran →</a><p class="staff-card-subtitle">Status pembayaran tidak dapat diubah manual oleh Staff.</p></section>
</aside></div>
