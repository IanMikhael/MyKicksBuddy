@model MyKicksBuddy.Models.Dtos.StaffPaymentsPageViewModel
@using MyKicksBuddy.Services
@using System.Globalization
@{ Layout = "_StaffLayout"; ViewData["Title"] = "Manajemen Pembayaran"; ViewData["StaffSection"] = "payments"; var culture = CultureInfo.GetCultureInfo("id-ID"); var selected = Model.Selected; }
<div class="staff-page-heading"><div><p class="staff-kicker">TRANSAKSI & PEMBAYARAN</p><h1 class="staff-page-title">Manajemen Pembayaran</h1><p class="staff-page-intro">Pantau status pembayaran yang benar-benar tercatat pada pesanan.</p></div><a class="staff-btn staff-btn-light" asp-action="Pos">Buka POS / Transaksi →</a></div>
<p class="staff-note is-warning">Provider pembayaran belum dikonfigurasi. Halaman ini hanya membaca data; verifikasi, refund, dan pembuatan transaksi dinonaktifkan.</p>
<form class="staff-toolbar staff-card" asp-action="Payments" method="get"><input class="staff-input" type="search" name="q" maxlength="80" value="@Model.Query" placeholder="Cari kode pesanan atau pelanggan..." aria-label="Cari pembayaran" /><select class="staff-select" name="status" aria-label="Filter status pembayaran"><option value="">Semua status</option>@foreach (var status in new[] { PaymentStatusWorkflow.Unpaid, PaymentStatusWorkflow.Paid, PaymentStatusWorkflow.Failed, PaymentStatusWorkflow.Expired }) { <option value="@status" selected="@(Model.Status == status)">@StaffPaymentPresentation.Label(status, false)</option> }</select><button class="staff-btn staff-btn-primary" type="submit">Cari / Filter</button><a class="staff-btn staff-btn-neutral" asp-action="Payments">Reset</a></form>
<div class="staff-payment-grid"><section class="staff-card"><div class="staff-section-head"><h2>Daftar Transaksi</h2><span class="staff-badge is-neutral">@Model.Total pesanan</span></div>@if (!Model.Payments.Any()) { <div class="staff-empty"><span class="staff-empty-icon"><img src="~/images/staff/figma/pos.svg" alt="" /></span><h2>Belum ada transaksi</h2><p>Data pembayaran akan muncul di sini ketika pesanan tersedia.</p></div> } else { <div class="staff-table-wrap"><table class="staff-table"><thead><tr><th>KODE PESANAN</th><th>PELANGGAN</th><th>TOTAL</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach (var payment in Model.Payments) { <tr><td><strong>@payment.OrderCode</strong><small>@payment.CreatedAt.ToString("dd MMM yyyy", culture)</small></td><td>@payment.CustomerName</td><td>@payment.TotalAmount.ToString("C0", culture)</td><td><span class="staff-badge @StaffPaymentPresentation.Tone(payment.PaymentStatus)">@StaffPaymentPresentation.Label(payment.PaymentStatus, payment.Provider is not null)</span></td><td><a class="staff-row-link" asp-action="PaymentStatus" asp-route-orderId="@payment.OrderId">Detail →</a></td></tr> }</tbody></table></div><nav class="staff-pagination" aria-label="Halaman pembayaran">@if (Model.Page > 1) { <a asp-action="Payments" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">← Sebelumnya</a> }<span>Halaman @Model.Page dari @Model.TotalPages</span>@if (Model.Page < Model.TotalPages) { <a asp-action="Payments" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Berikutnya →</a> }</nav> }</section><aside class="staff-card staff-payment-detail"><h2>Ringkasan Pembayaran</h2>@if (selected is null) { <p class="staff-card-subtitle">Belum ada pembayaran untuk ditinjau.</p> } else { <dl><div><dt>Kode pesanan</dt><dd>@selected.OrderCode</dd></div><div><dt>Pelanggan</dt><dd>@selected.CustomerName</dd></div><div><dt>Layanan</dt><dd>@(selected.ServiceName ?? "—")</dd></div><div><dt>Total</dt><dd>@selected.TotalAmount.ToString("C0", culture)</dd></div><div><dt>Status</dt><dd>@StaffPaymentPresentation.Label(selected.PaymentStatus, selected.Provider is not null)</dd></div><div><dt>Provider</dt><dd>@(selected.Provider ?? "Belum ada provider")</dd></div></dl><a class="staff-btn staff-btn-primary" asp-action="PaymentStatus" asp-route-orderId="@selected.OrderId">Lihat Status Pembayaran →</a> }<p class="staff-note is-warning">Konfirmasi manual tidak tersedia: belum ada integrasi provider maupun aturan kasir offline.</p></aside></div>
