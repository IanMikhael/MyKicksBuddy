@model IReadOnlyList<MyKicksBuddy.Models.Dtos.StaffActivityRow>
@using MyKicksBuddy.Services
@using System.Globalization
@{ Layout = "_StaffLayout"; ViewData["Title"] = "Notifikasi Operasional"; ViewData["StaffSection"] = "notifications"; var culture = CultureInfo.GetCultureInfo("id-ID"); }
<div class="staff-page-heading"><div><p class="staff-kicker">AKTIVITAS OPERASIONAL</p><h1 class="staff-page-title">Notifikasi Operasional</h1><p class="staff-page-intro">Aktivitas berdasarkan log status pesanan yang tersimpan, bukan pesan atau alert buatan.</p></div><a class="staff-btn staff-btn-light" asp-action="Orders">Lihat Pesanan →</a></div>
<div class="staff-feed-grid"><section class="staff-feed-list">@if (!Model.Any()) { <div class="staff-card staff-empty"><span class="staff-empty-icon"><img src="~/images/staff/figma/notifications.svg" alt="" /></span><h2>Belum ada aktivitas</h2><p>Perubahan pesanan yang tercatat akan tampil di sini.</p></div> } else { @foreach (var activity in Model) { <article class="staff-feed-item staff-card"><span class="staff-feed-icon"><img src="~/images/staff/figma/notifications.svg" alt="" /></span><div class="staff-feed-item-main"><h3>@OrderStatusWorkflow.Label(activity.Status) · @activity.OrderCode</h3><p>@activity.CustomerName@if (!string.IsNullOrWhiteSpace(activity.Note)) { <span> — @activity.Note</span> }</p><small>@activity.CreatedAt.ToString("dd MMM yyyy, HH:mm", culture)</small></div><a class="staff-link" asp-action="Detail" asp-route-id="@activity.OrderId">Detail →</a></article> } }</section><aside class="staff-card staff-card-pad"><h2 class="staff-card-title">Pusat Aktivitas Staff</h2><p class="staff-card-subtitle">Daftar ini bersumber dari riwayat perubahan status. Fitur dibaca/belum dibaca dan notifikasi real-time belum memiliki penyimpanan atau layanan pengiriman.</p><p class="staff-note">Tidak ada indikator pesan baru palsu atau tombol “tandai dibaca” tanpa backend.</p></aside></div>
