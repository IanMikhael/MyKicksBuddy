@model MyKicksBuddy.Models.Dtos.StaffPosPageViewModel
@using MyKicksBuddy.Services
@using System.Globalization
@{ Layout = "_StaffLayout"; ViewData["Title"] = "POS & Verifikasi Pembayaran"; ViewData["StaffSection"] = "pos"; var culture = CultureInfo.GetCultureInfo("id-ID"); }
<div class="staff-page-heading"><div><p class="staff-kicker">KASIR / POINT OF SALE</p><h1 class="staff-page-title">Point of Sale (POS) &amp; Verifikasi Pembayaran</h1><p class="staff-page-intro">Temukan pesanan dan tinjau data transaksi sebelum proses pembayaran tersedia.</p></div><span class="staff-badge is-warning">Mode baca saja</span></div><p class="staff-note is-warning">Provider online dan aturan pembayaran kasir offline belum dikonfigurasi. Tidak ada transaksi, QR, pembayaran berhasil, atau verifikasi yang dapat dibuat dari portal ini.</p>
<div class="staff-pos-grid"><div class="staff-pos-column"><section class="staff-card"><h2 class="staff-card-title">Cari Pesanan Pelanggan</h2><p class="staff-card-subtitle">Cari kode pesanan, nama pelanggan, atau layanan.</p><form class="staff-toolbar" asp-action="Pos" method="get"><input class="staff-input" type="search" name="q" maxlength="80" value="@Model.Query" placeholder="Contoh: MKB-12345 atau nama pelanggan" aria-label="Cari pesanan untuk POS" /><button class="staff-btn staff-btn-primary" type="submit">Cari Pesanan</button></form>@if (Model.Query is null) { <p class="staff-card-subtitle">Masukkan kata kunci untuk mulai mencari.</p> } else if (!Model.Results.Any()) { <p class="staff-note">Pesanan tidak ditemukan untuk kata kunci tersebut.</p> } else { @foreach (var order in Model.Results) { <div class="staff-pos-result"><span><strong>@order.OrderCode · @order.CustomerName</strong><small>@(order.ServiceName ?? "Layanan") · @StaffPaymentPresentation.Label(order.PaymentStatus, false)</small></span><a class="staff-btn staff-btn-light" asp-action="Pos" asp-route-q="@Model.Query" asp-route-orderId="@order.Id">Tinjau</a></div> } }</section><section class="staff-card"><h2 class="staff-card-title">Pilih Metode Pembayaran</h2><p class="staff-card-subtitle">Pilihan visual dari desain Staff. Semuanya nonaktif sampai alur transaksi resmi tersedia.</p><div class="staff-pos-methods"><div class="staff-pos-method"><strong>QRIS / Pembayaran Online</strong><small>Belum ada provider terkonfigurasi</small></div><div class="staff-pos-method"><strong>Transfer Bank</strong><small>Belum ada konfirmasi otomatis</small></div><div class="staff-pos-method"><strong>Tunai / Kasir</strong><small>Aturan dan audit offline belum tersedia</small></div><div class="staff-pos-method"><strong>E-Wallet</strong><small>Belum ada provider terkonfigurasi</small></div></div></section></div><aside class="staff-pos-column"><section class="staff-card staff-pos-summary"><h2 class="staff-card-title">Ringkasan Pesanan</h2>@if (Model.Selected is null) { <p class="staff-card-subtitle">Pilih pesanan dari hasil pencarian untuk meninjau tagihan.</p> } else { <dl><div><dt>Kode</dt><dd>@Model.Selected.OrderCode</dd></div><div><dt>Pelanggan</dt><dd>@Model.Selected.CustomerName</dd></div><div><dt>Layanan</dt><dd>@(Model.Selected.ServiceName ?? "—")</dd></div><div><dt>Status pembayaran</dt><dd>@StaffPaymentPresentation.Label(Model.Selected.PaymentStatus, Model.Selected.Provider is not null)</dd></div><div><dt>Total pembayaran</dt><dd>@Model.Selected.TotalAmount.ToString("C0", culture)</dd></div></dl><a class="staff-btn staff-btn-light" asp-action="PaymentStatus" asp-route-orderId="@Model.Selected.OrderId">Lihat Status Pembayaran</a> }<button class="staff-btn staff-btn-primary" type="button" disabled title="Provider dan aturan transaksi kasir belum tersedia">Proses Pembayaran (belum tersedia)</button></section><section class="staff-card"><h2 class="staff-card-title">Keamanan Pembayaran</h2><p class="staff-card-subtitle">Status pembayaran hanya berubah melalui jalur backend yang terverifikasi. Staff tidak dapat menandai pembayaran berhasil secara manual.</p></section></aside></div>
