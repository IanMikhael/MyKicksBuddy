@model MyKicksBuddy.Models.Dtos.StaffProfilePageViewModel
@{ Layout = "_StaffLayout"; ViewData["Title"] = "Profil Staff"; ViewData["StaffSection"] = "profile"; var name = Model.User.FullName; var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant(); }
<div class="staff-page-heading"><div><p class="staff-kicker">AKUN STAFF</p><h1 class="staff-page-title">Profil Saya</h1><p class="staff-page-intro">Informasi akun staff yang sedang masuk.</p></div></div>
<section class="staff-profile-card staff-card"><div class="staff-profile-header"><span class="staff-avatar">@initials</span><h2>@name</h2><span class="staff-badge">Staff / Kasir</span></div><div class="staff-profile-details"><h3>INFORMASI AKUN</h3><div><span>Nama lengkap</span><strong>@name</strong></div><div><span>Email</span><strong>@(Model.User.Email ?? "Belum tersedia")</strong></div><div><span>Nomor ponsel</span><strong>@(Model.User.Phone ?? "Belum tersedia")</strong></div><div><span>Peran</span><strong>Staff / Kasir</strong></div></div><p class="staff-note">Perubahan profil dan kata sandi belum tersedia di portal Staff. Hubungi pengelola akun bila data perlu diperbarui.</p><div class="staff-profile-logout"><form asp-controller="Auth" asp-action="Logout" method="post"><button type="submit">Keluar dari Akun</button></form></div></section>
