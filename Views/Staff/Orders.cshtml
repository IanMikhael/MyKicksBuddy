@model MyKicksBuddy.Models.Dtos.StaffOrdersPageViewModel
@using MyKicksBuddy.Services
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Antrean Pesanan Masuk";
    ViewData["StaffSection"] = "orders";
    var selected = Model.Orders.FirstOrDefault();
}
<div class="staff-page-heading"><div><p class="staff-kicker">OPERASIONAL PESANAN</p><h1 class="staff-page-title">Antrean Pesanan Masuk</h1><p class="staff-page-intro">Kelola dan tinjau seluruh pesanan perawatan sepatu pelanggan.</p></div><a class="staff-btn staff-btn-light" asp-action="Search">Cari Pesanan</a></div>
<section class="staff-order-summary staff-card"><div><small>TOTAL ANTREAN</small><strong>@Model.Total pesanan</strong></div><div><small>PERLU TINDAKAN</small><strong>@Model.Counts.NeedsAction pesanan</strong></div><a class="staff-btn staff-btn-neutral" asp-action="Orders">⟳ Segarkan</a></section>
<form class="staff-toolbar staff-card" method="get" asp-action="Orders"><input class="staff-input" name="q" value="@Model.Query" type="search" maxlength="80" placeholder="Cari kode pesanan, pelanggan, atau layanan..." aria-label="Cari pesanan" /><select class="staff-select" name="status" aria-label="Filter status pesanan"><option value="">Semua status pesanan</option>@foreach (var status in OrderStatusWorkflow.AllStatuses) { <option value="@status" selected="@(Model.Status == status)">@OrderStatusWorkflow.Label(status)</option> }</select><select class="staff-select" name="paymentStatus" aria-label="Filter status pembayaran"><option value="">Semua pembayaran</option>@foreach (var status in new[] { PaymentStatusWorkflow.Unpaid, PaymentStatusWorkflow.Paid, PaymentStatusWorkflow.Failed, PaymentStatusWorkflow.Expired }) { <option value="@status" selected="@(Model.PaymentStatus == status)">@StaffPaymentPresentation.Label(status, false)</option> }</select><button class="staff-btn staff-btn-primary" type="submit">Cari / Filter</button><a class="staff-btn staff-btn-neutral" asp-action="Orders">Reset</a></form>
<nav class="staff-filter-tabs" aria-label="Filter cepat"><a class="@(Model.Status is null ? "is-active" : "")" asp-action="Orders" asp-route-q="@Model.Query">Semua Pesanan</a><a class="@(Model.Status == OrderStatusWorkflow.PendingPayment ? "is-active" : "")" asp-action="Orders" asp-route-q="@Model.Query" asp-route-status="@OrderStatusWorkflow.PendingPayment">Menunggu Pembayaran</a><a class="@(Model.Status == OrderStatusWorkflow.WaitingApproval ? "is-active" : "")" asp-action="Orders" asp-route-q="@Model.Query" asp-route-status="@OrderStatusWorkflow.WaitingApproval">Menunggu Persetujuan</a><a class="@(Model.Status == OrderStatusWorkflow.InProcess ? "is-active" : "")" asp-action="Orders" asp-route-q="@Model.Query" asp-route-status="@OrderStatusWorkflow.InProcess">Diproses</a><a class="@(Model.Status == OrderStatusWorkflow.Completed ? "is-active" : "")" asp-action="Orders" asp-route-q="@Model.Query" asp-route-status="@OrderStatusWorkflow.Completed">Selesai</a></nav>
<div class="staff-list-grid"><partial name="_OrderTable" model="Model" />
    <aside class="staff-card staff-list-preview"><h3>Inspeksi Cepat</h3>@if (selected is null) { <p class="staff-dim">Pilih pesanan dari antrean untuk melihat ringkasannya.</p> } else { <p class="staff-kicker">@selected.OrderCode</p><img class="staff-preview-image" src="~/images/landing/service-cleaning.png" alt="Ilustrasi perawatan sepatu" /><div class="staff-preview-grid"><div><small>PELANGGAN</small><strong>@selected.CustomerName</strong></div><div><small>LAYANAN</small><strong>@(selected.ServiceName ?? "—")</strong></div><div><small>STATUS PESANAN</small><strong>@OrderStatusWorkflow.DisplayLabel(selected.Status, selected.PaymentStatus)</strong></div><div><small>LOKASI PENJEMPUTAN</small><strong>@(selected.FullAddress ?? "Tidak ada alamat penjemputan")</strong></div><div><small>CATATAN PESANAN</small><strong>@(Model.SelectedDetail?.Notes ?? "Tidak ada catatan")</strong></div><div><small>STATUS PEMBAYARAN</small><strong>@StaffPaymentPresentation.Label(selected.PaymentStatus, false)</strong></div></div><a class="staff-btn staff-btn-primary" asp-action="Detail" asp-route-id="@selected.Id">Ubah Status Pesanan →</a><a class="staff-btn staff-btn-light" asp-action="PaymentStatus" asp-route-orderId="@selected.Id">Lihat Detail Pembayaran</a> }</aside>
</div>
