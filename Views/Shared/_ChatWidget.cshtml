<aside class="chat-widget" aria-label="Pusat bantuan">
    <section class="chat-panel" id="chatPanel" aria-label="Pintasan bantuan" hidden>
        <div class="chat-panel-header">
            <div class="chat-brand"><span class="chat-brand-mark">M</span><div><strong>MyKicksBuddy</strong><span><i></i>Online</span></div></div>
            <div class="chat-window-actions"><button type="button" class="icon-button" data-chat-close aria-label="Minimalkan bantuan">−</button><button type="button" class="icon-button" data-chat-close aria-label="Tutup bantuan">×</button></div>
        </div>
        <div class="chat-message">Halo!<br />Saya dapat membantu informasi layanan, harga, dan status pesanan.</div>
        <form class="chat-input" data-chat-form>
            <input type="text" aria-label="Tulis pesan" placeholder="Tulis pesan..." autocomplete="off" />
