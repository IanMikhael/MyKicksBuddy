@model MyKicksBuddy.Models.Dtos.LoginRequest
@{Layout=null;ViewData["Title"]="Masuk sebagai Admin";}
<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Masuk sebagai Admin - MyKicksBuddy</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head><body class="admin-login-page"><main class="admin-login-card"><div class="admin-login-mark">M</div><div class="admin-login-identity"><strong>Mykicksbuddy</strong><span>ADMIN PORTAL</span></div><h1>Masuk sebagai Admin</h1><p>Akses pusat kontrol operasional, layanan, pembayaran, dan laporan Mykicksbuddy.</p><form action="/auth/admin-login" method="post" data-auth-form="login" data-admin-url="/admin" novalidate>@Html.AntiForgeryToken()<div class="admin-login-alert" data-form-alert role="alert" hidden></div><label for="EmailOrPhone">Email atau username</label><input id="EmailOrPhone" name="EmailOrPhone" autocomplete="username" required placeholder="Masukkan email atau username admin"/><span data-error-for="EmailOrPhone" class="admin-field-error"></span><label for="LoginPassword">Kata Sandi</label><div class="admin-password"><input id="LoginPassword" name="Password" type="password" autocomplete="current-password" required placeholder="Masukkan kata sandi"/><button type="button" data-password-toggle="LoginPassword" aria-label="Tampilkan kata sandi">Tampilkan</button></div><span data-error-for="Password" class="admin-field-error"></span><button type="submit" class="admin-login-submit" data-submit-button><span data-submit-label>Masuk</span></button></form><a href="/">← Kembali ke beranda</a><small>Khusus akses Administrator resmi Mykicksbuddy.</small></main><script src="~/js/auth.js" asp-append-version="true"></script></body></html>
