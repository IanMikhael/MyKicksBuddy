@model IReadOnlyList<MyKicksBuddy.Models.Dtos.AdminEventRow>
@using MyKicksBuddy.Services
@using System.Globalization
@{Layout="_AdminLayout";ViewData["Title"]="Pusat Notifikasi Operasional";var id=CultureInfo.GetCultureInfo("id-ID");}
<header class="portal-page-head"><div><p class="portal-eyebrow">AKTIVITAS OPERASIONAL</p><h1>Pusat Notifikasi Operasional</h1><p>Feed dari log status pesanan yang benar-benar tercatat.</p></div></header><section class="portal-card"><div class="portal-card-head"><h2>Aktivitas Terbaru</h2><span>@Model.Count peristiwa</span></div>@if(Model.Count==0){<div class="portal-empty"><h3>Belum ada aktivitas</h3><p>Perubahan status pesanan akan tampil di sini.</p></div>}else{<ol class="portal-timeline">@foreach(var e in Model){<li><span></span><div><strong>@OrderStatusWorkflow.Label(e.Status) · @e.OrderCode</strong><time>@e.CreatedAt.ToString("dd MMM yyyy, HH:mm",id)</time>@if(!string.IsNullOrWhiteSpace(e.Note)){<p>@e.Note</p>}<a class="portal-link" asp-action="OrderDetail" asp-route-id="@e.OrderId">Lihat Pesanan</a></div></li>}</ol>}</section><p class="portal-muted">Belum ada penyimpanan status dibaca/belum dibaca atau push notification.</p>
