@model IReadOnlyList<MyKicksBuddy.Models.Dtos.InternalUserDto>
@{Layout="_AdminLayout";ViewData["Title"]="User Internal";}
<header class="portal-page-head"><div><p class="portal-eyebrow">AKSES INTERNAL</p><h1>User internal</h1><p>Daftar akun kasir dan admin yang tersimpan. Pengubahan akun belum dibuka pada fase frontend-first ini.</p></div></header>
<section class="portal-card portal-table-card">@if(!Model.Any()){<div class="portal-empty"><h3>Belum ada user internal</h3><p>Akun internal belum tersedia di database.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Nama</th><th>Role</th><th>Email</th><th>Telepon</th><th>Status</th><th>Dibuat</th></tr></thead><tbody>@foreach(var u in Model){<tr><td><strong>@u.FullName</strong></td><td>@u.Role</td><td>@(u.Email??"—")</td><td>@(u.Phone??"—")</td><td><span class="portal-chip @(u.IsActive?"is-status":"")">@(u.IsActive?"Aktif":"Nonaktif")</span></td><td>@u.CreatedAt.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>}</section>
