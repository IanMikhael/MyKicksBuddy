@model MyKicksBuddy.Models.Dtos.AdminProfileViewModel
@{Layout="_AdminLayout";ViewData["Title"]="Profil & Pengaturan Akun Admin";}
<header class="portal-page-head"><div><p class="portal-eyebrow">KEAMANAN PUSAT</p><h1>Profil &amp; Pengaturan Akun Admin</h1><p>Kelola identitas dan kredensial akun yang sedang masuk.</p></div></header>
<p><a class="portal-link" asp-action="SystemStatus">Lihat status sistem →</a></p>
@if(TempData["Success"] is string success){<div class="portal-alert is-success">@success</div>}@if(TempData["Error"] is string error){<div class="portal-alert is-error">@error</div>}
<div class="admin-two-col"><div><section class="portal-card"><div class="admin-profile-head"><span class="admin-avatar">@(Model.FullName.Trim().FirstOrDefault())</span><div><h2>@Model.FullName</h2><span class="portal-chip is-status">@Model.Role</span></div></div><dl class="portal-dl"><div><dt>Email</dt><dd>@(Model.Email??"Tidak tersedia")</dd></div><div><dt>Nomor ponsel</dt><dd>@(Model.Phone??"Tidak tersedia")</dd></div><div><dt>Role</dt><dd>@Model.Role</dd></div></dl><form asp-controller="Auth" asp-action="Logout" method="post"><button class="portal-secondary" type="submit">Keluar</button></form></section><section class="portal-card"><h2>Edit Profil</h2><form class="portal-form" asp-action="UpdateProfile" method="post"><label>Nama lengkap<input name="FullName" value="@Model.FullName" required maxlength="255"/></label><label>Email<input name="Email" type="email" value="@Model.Email" required maxlength="255"/></label><label>Nomor ponsel<input name="Phone" type="tel" value="@Model.Phone" maxlength="30"/></label><button type="submit">Simpan Profil</button></form></section></div><section class="portal-card"><h2>Ubah Kata Sandi</h2><p class="portal-muted">Masukkan kata sandi saat ini sebelum menetapkan yang baru.</p><form class="portal-form" asp-action="ChangePassword" method="post"><label>Kata sandi saat ini<input name="CurrentPassword" type="password" autocomplete="current-password" required/></label><label>Kata sandi baru<input name="NewPassword" type="password" autocomplete="new-password" minlength="8" required/></label><label>Konfirmasi kata sandi baru<input name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required/></label><button type="submit">Perbarui Kata Sandi</button></form><p class="portal-note">Password tidak ditampilkan atau disimpan sebagai plaintext.</p></section></div>
