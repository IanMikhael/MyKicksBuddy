@model MyKicksBuddy.Models.Dtos.AdminDashboardViewModel
@using System.Globalization
@using MyKicksBuddy.Services
@{Layout="_AdminLayout";ViewData["Title"]="Dashboard";var s=Model.Summary;var id=CultureInfo.GetCultureInfo("id-ID");}
<header class="portal-page-head"><div><p class="portal-eyebrow">RINGKASAN OPERASI HARIAN</p><h1>Halo, @User.Identity?.Name</h1><p>Pusat kendali operasional, pembayaran, dan tindak lanjut pesanan masuk.</p></div><div class="portal-actions"><a class="portal-secondary" asp-action="Reports">Lihat Laporan</a><a class="portal-primary" asp-action="Pos">Transaksi POS</a></div></header>
<section class="portal-stats admin-kpis"><article class="portal-stat"><span>MENUNGGU PEMBAYARAN</span><strong>@s.PendingPayments</strong><small>Seluruh pesanan pending payment</small></article><article class="portal-stat"><span>MENUNGGU TINDAK LANJUT</span><strong>@s.WaitingApprovalOrders</strong><small>Seluruh pesanan waiting approval</small></article><article class="portal-stat"><span>PEMBAYARAN TERKONFIRMASI</span><strong>@s.PaidOrders</strong><small>Seluruh pesanan berstatus paid</small></article><article class="portal-stat"><span>TOTAL TRANSAKSI</span><strong>@s.TotalOrders</strong><small>Seluruh pesanan tersimpan</small></article></section>
<div class="admin-dashboard-grid"><div><section class="portal-card portal-table-card"><div class="portal-card-head"><div><p class="portal-eyebrow">PRIORITAS OPERASIONAL</p><h2>Pesanan Perlu Ditindaklanjuti</h2></div><a class="portal-link" asp-action="Orders" asp-route-status="waiting_approval">Lihat Semua</a></div>@if(Model.PriorityOrders.Count==0){<div class="portal-empty"><h3>Tidak ada antrean persetujuan</h3><p>Pesanan yang pembayaran dan statusnya memenuhi syarat akan muncul di sini.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Kode Pesanan</th><th>Pelanggan</th><th>Status Pembayaran</th><th>Aksi</th></tr></thead><tbody>@foreach(var o in Model.PriorityOrders){<tr><td><strong>@o.OrderCode</strong></td><td>@o.CustomerName</td><td><span class="portal-chip is-status">@(o.PaymentStatus=="paid"?"Terbayar":"Belum dibayar")</span></td><td><a class="portal-link" asp-action="OrderDetail" asp-route-id="@o.Id">Lihat Pesanan</a></td></tr>}</tbody></table></div>}</section><section class="portal-card portal-table-card"><div class="portal-card-head"><h2>Aktivitas Transaksi Terbaru</h2><a class="portal-link" asp-action="Orders">Semua Transaksi</a></div>@if(Model.RecentOrders.Count==0){<div class="portal-empty"><h3>Belum ada transaksi</h3><p>Aktivitas pesanan nyata akan tampil di sini.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Kode</th><th>Pelanggan</th><th>Metode</th><th>Status</th><th>Waktu</th></tr></thead><tbody>@foreach(var o in Model.RecentOrders){<tr><td><a class="portal-link" asp-action="OrderDetail" asp-route-id="@o.Id">@o.OrderCode</a></td><td>@o.CustomerName</td><td>@(o.FulfillmentType=="pickup_delivery"?"Antar-jemput":"Drop-off")</td><td>@OrderStatusWorkflow.Label(o.Status)</td><td>@o.CreatedAt.ToString("dd MMM, HH:mm",id)</td></tr>}</tbody></table></div>}</section></div><aside><section class="portal-card"><p class="portal-eyebrow">RINGKASAN LAPORAN</p><h2>Ikhtisar Seluruh Periode</h2><div class="admin-report-rows"><div><span>Total Transaksi</span><strong>@s.TotalOrders</strong></div><div><span>Total Pendapatan</span><strong>@s.PaidRevenue.ToString("C0",id)</strong></div><div><span>Pesanan Selesai</span><strong>@s.CompletedOrders</strong></div><div><span>Pesanan Aktif</span><strong>@s.ActiveOrders</strong></div></div><small class="portal-muted">Pendapatan hanya dari order berstatus paid.</small></section><section class="portal-card"><p class="portal-eyebrow">NOTIFIKASI OPERASIONAL</p><h2>Aktivitas Sistem</h2><p class="portal-muted">Peristiwa yang tercatat dapat dilihat di feed operasional. Tidak ada badge unread tanpa data baca.</p><a class="portal-link" asp-action="Notifications">Lihat Aktivitas →</a></section></aside></div>
