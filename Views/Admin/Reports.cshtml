@model MyKicksBuddy.Models.Dtos.AdminReportViewModel
@using System.Globalization
@{Layout="_AdminLayout";ViewData["Title"]="Laporan Operasional & Transaksi";var id=CultureInfo.GetCultureInfo("id-ID");var max=Math.Max(1,Model.DailyOrders.Select(x=>x.Orders).DefaultIfEmpty(0).Max());}
<header class="portal-page-head"><div><p class="portal-eyebrow">MONITORING ANALITIK</p><h1>Laporan Operasional &amp; Transaksi</h1><p>Ikhtisar berdasarkan tanggal pembuatan pesanan pada rentang terpilih.</p></div></header>
<form class="portal-filter" method="get"><label>Dari<input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" required/></label><label>Sampai<input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" required/></label><button type="submit">Terapkan periode</button><a asp-action="Reports">30 hari terakhir</a></form>
<section class="portal-stats admin-kpis"><article class="portal-stat"><span>TOTAL TRANSAKSI</span><strong>@Model.TotalOrders</strong><small>Pesanan dibuat pada periode ini</small></article><article class="portal-stat"><span>TOTAL PENDAPATAN</span><strong>@Model.PaidRevenue.ToString("C0",id)</strong><small>Hanya pesanan berstatus paid</small></article><article class="portal-stat"><span>PESANAN SELESAI</span><strong>@Model.CompletedOrders</strong><small>Order status completed</small></article><article class="portal-stat"><span>SEDANG DIPROSES</span><strong>@Model.InProcessOrders</strong><small>Order status in_process</small></article></section>
<div class="admin-two-col"><section class="portal-card"><div class="portal-card-head"><h2>Tren Transaksi</h2><span>@Model.From.ToString("dd MMM",id) – @Model.To.ToString("dd MMM yyyy",id)</span></div>@if(Model.DailyOrders.Count==0){<div class="portal-empty"><h3>Belum ada data pada periode ini</h3><p>Grafik akan terisi dari pesanan yang benar-benar tersimpan.</p></div>}else{<div class="admin-chart" role="img" aria-label="Jumlah pesanan harian">@foreach(var point in Model.DailyOrders){<div class="admin-chart-bar"><span style="height:@(Math.Max(4,(int)Math.Round(100.0*point.Orders/max)))%"></span><small>@point.Day.ToString("dd MMM",id)</small><b>@point.Orders</b></div>}</div>}</section><section class="portal-card"><h2>Status Pembayaran</h2><div class="admin-report-rows"><div><span>Terbayar</span><strong>@Model.PaidOrders</strong></div><div><span>Belum dibayar</span><strong>@Model.UnpaidOrders</strong></div><div><span>Gagal</span><strong>@Model.FailedOrders</strong></div><div><span>Kedaluwarsa</span><strong>@Model.ExpiredOrders</strong></div></div><p class="portal-note">Provider pembayaran belum dikonfigurasi. Tidak ada sinkronisasi atau verifikasi manual.</p></section></div>
