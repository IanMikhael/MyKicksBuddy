@model MyKicksBuddy.Models.Dtos.OrdersPageViewModel
@using System.Globalization
@using MyKicksBuddy.Services
@{Layout="_AdminLayout";ViewData["Title"]="Manajemen Pesanan";var id=CultureInfo.GetCultureInfo("id-ID");}
<header class="portal-page-head"><div><p class="portal-eyebrow">OPERASIONAL RESTORASI</p><h1>Manajemen Pesanan</h1><p>Kelola pesanan online masuk dan tindak lanjut sesuai status pembayaran.</p></div></header>
<section class="portal-stats admin-kpis"><article class="portal-stat"><span>HASIL FILTER</span><strong>@Model.TotalCount</strong><small>Pesanan ditemukan</small></article><article class="portal-stat"><span>HALAMAN</span><strong>@Model.Page</strong><small>20 entri per halaman</small></article></section>
<form class="portal-filter" method="get"><label>Cari pesanan<input name="search" value="@Model.Search" placeholder="Kode, pelanggan, atau layanan"/></label><label>Status pesanan<select name="status"><option value="">Semua status</option>@foreach(var s in OrderStatusWorkflow.AllStatuses){<option value="@s" selected="@(Model.Status==s)">@OrderStatusWorkflow.Label(s)</option>}</select></label><label>Pembayaran<select name="paymentStatus"><option value="">Semua status</option>@foreach(var s in new[]{"unpaid","paid","failed","expired"}){<option value="@s" selected="@(Model.PaymentStatus==s)">@s</option>}</select></label><label>Dari<input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></label><label>Sampai<input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></label><button type="submit">Terapkan</button><a asp-action="Orders">Reset</a></form>
<section class="portal-card portal-table-card"><div class="portal-card-head"><h2>Daftar Pesanan</h2><span>@Model.TotalCount pesanan</span></div>@if(Model.Orders.Count==0){<div class="portal-empty"><h3>Data tidak ditemukan</h3><p>Belum ada pesanan yang cocok dengan filter.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Kode Pesanan</th><th>Pelanggan</th><th>Dibuat</th><th>Fulfillment</th><th>Pembayaran</th><th>Status</th><th>Total</th><th>Aksi</th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td><strong>@o.OrderCode</strong></td><td>@o.CustomerName</td><td>@o.CreatedAt.ToString("dd MMM yy, HH:mm",id)</td><td>@(o.FulfillmentType=="pickup_delivery"?"Antar-jemput":"Drop-off")</td><td><span class="portal-chip">@(o.PaymentStatus switch {"paid"=>"Terbayar","failed"=>"Gagal","expired"=>"Kedaluwarsa",_=>"Belum dibayar"})</span></td><td><span class="portal-chip is-status">@OrderStatusWorkflow.Label(o.Status)</span></td><td>@o.TotalAmount.ToString("C0",id)</td><td><a class="portal-link" asp-action="OrderDetail" asp-route-id="@o.Id">Lihat Detail</a></td></tr>}</tbody></table></div><div class="admin-pagination"><span>Halaman @Model.Page dari @Math.Max(1,(int)Math.Ceiling(Model.TotalCount/20.0))</span><div>@if(Model.Page>1){<a asp-action="Orders" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Sebelumnya</a>}@if(Model.Page*20<Model.TotalCount){<a asp-action="Orders" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Berikutnya</a>}</div></div>}</section>
