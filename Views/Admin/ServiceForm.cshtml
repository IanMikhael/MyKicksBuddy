@model MyKicksBuddy.Models.Dtos.ServiceAdminFormModel
@{Layout="_AdminLayout";ViewData["Title"]=Model.Id>0?"Edit Layanan":"Tambah Layanan";var editing=Model.Id>0;}
<a class="portal-back" asp-action="Services">← Kembali ke layanan</a><header class="portal-page-head"><div><p class="portal-eyebrow">KATALOG</p><h1>@(editing?"Edit layanan":"Tambah layanan")</h1><p>Data ini langsung digunakan pada pilihan pesanan customer.</p></div></header>
<section class="portal-card"><form class="portal-form portal-form-grid" asp-action="@(editing?"EditService":"CreateService")" asp-route-id="@(editing?Model.Id:null)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="portal-alert is-error"></div><label>Nama layanan<input asp-for="Name"/><span asp-validation-for="Name"></span></label><label>Harga<input asp-for="Price" type="number" min="0" step="1000"/><span asp-validation-for="Price"></span></label><label>Estimasi hari<input asp-for="EstimatedDurationDays" type="number" min="1"/></label><label class="portal-switch"><input asp-for="IsActive"/> Aktif dan tampil untuk customer</label><label class="is-wide">Deskripsi<textarea asp-for="Description" rows="5"></textarea></label><div class="portal-actions is-wide"><button type="submit">Simpan layanan</button><a class="portal-secondary" asp-action="Services">Batal</a></div></form></section>
