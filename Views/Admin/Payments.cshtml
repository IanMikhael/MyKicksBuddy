@model IReadOnlyList<MyKicksBuddy.Models.Dtos.AdminPaymentRow>
@using System.Globalization
@{Layout="_AdminLayout";ViewData["Title"]="Monitoring Pembayaran";var selected=ViewData["Status"]?.ToString();var search=ViewData["Search"]?.ToString();var id=CultureInfo.GetCultureInfo("id-ID");}
<header class="portal-page-head"><div><p class="portal-eyebrow">GATEWAY MONITORING</p><h1>Monitoring Pembayaran</h1><p>Data pembayaran dan status pesanan yang tersimpan di database.</p></div><span class="portal-chip">Provider belum dikonfigurasi</span></header>
<section class="portal-stats admin-kpis"><article class="portal-stat"><span>TOTAL TAGIHAN</span><strong>@Model.Sum(x=>x.TotalAmount).ToString("C0",id)</strong><small>@Model.Count pesanan pada filter</small></article><article class="portal-stat"><span>TERBAYAR</span><strong>@Model.Count(x=>x.PaymentStatus=="paid")</strong></article><article class="portal-stat"><span>BELUM DIBAYAR</span><strong>@Model.Count(x=>x.PaymentStatus=="unpaid")</strong></article><article class="portal-stat"><span>GAGAL / KEDALUWARSA</span><strong>@Model.Count(x=>x.PaymentStatus is "failed" or "expired")</strong></article></section>
<form class="portal-filter" method="get"><label>Cari pesanan<input name="search" value="@search" placeholder="Kode atau nama pelanggan"/></label><label>Status<select name="status"><option value="">Semua</option>@foreach(var s in new[]{"unpaid","paid","failed","expired"}){<option value="@s" selected="@(selected==s)">@s</option>}</select></label><button type="submit">Terapkan</button><a asp-action="Payments">Reset</a></form>
<section class="portal-card portal-table-card"><div class="portal-card-head"><h2>Daftar Transaksi Pembayaran</h2><span>@Model.Count entri</span></div>@if(Model.Count==0){<div class="portal-empty"><h3>Belum ada pembayaran</h3><p>Pesanan yang tersimpan akan muncul di sini tanpa data contoh.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Kode Pesanan</th><th>Pelanggan</th><th>Metode / Provider</th><th>Total</th><th>Status</th><th>Dibuat</th><th>Aksi</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.OrderCode</strong></td><td>@p.CustomerName</td><td>@(p.Provider??"Belum tersedia")</td><td>@p.TotalAmount.ToString("C0",id)</td><td><span class="portal-chip is-status">@(p.PaymentStatus switch {"paid"=>"Terbayar","failed"=>"Gagal","expired"=>"Kedaluwarsa",_=>p.HasAttempt?"Menunggu pembayaran":"Belum dibayar"})</span></td><td>@p.CreatedAt.ToString("dd MMM yyyy, HH:mm",id)</td><td><a class="portal-link" asp-action="OrderDetail" asp-route-id="@p.OrderId">Lihat Detail</a></td></tr>}</tbody></table></div>}</section><p class="portal-note">Pemeriksaan gateway dan perubahan status bayar tidak tersedia sampai provider resmi dikonfigurasi.</p>
