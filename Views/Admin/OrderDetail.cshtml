@model MyKicksBuddy.Models.Dtos.OrderDetailPageViewModel
@using System.Globalization
@using MyKicksBuddy.Services
@{Layout="_AdminLayout";ViewData["Title"]="Detail Pesanan";var o=Model.Order;}
<a class="portal-back" asp-action="Orders">← Kembali ke pesanan</a><header class="portal-page-head"><div><p class="portal-eyebrow">DETAIL TRANSAKSI</p><h1>@o.OrderCode</h1><p>@o.CustomerName · @o.CustomerEmail · @o.CustomerPhone</p></div><span class="portal-chip is-status is-large">@OrderStatusWorkflow.Label(o.Status)</span></header>
@if(TempData["Success"] is string success){<div class="portal-alert is-success">@success</div>}@if(TempData["Error"] is string error){<div class="portal-alert is-error">@error</div>}
<div class="portal-detail-grid"><div><section class="portal-card"><div class="portal-card-head"><h2>Item dan total</h2><span>@o.CreatedAt.ToString("dd MMM yyyy, HH:mm",CultureInfo.GetCultureInfo("id-ID"))</span></div>@foreach(var item in o.Items){<div class="portal-line-item"><div><strong>@item.ServiceName</strong><span>@item.ShoeDescription · @item.Quantity × @item.Price.ToString("C0",CultureInfo.GetCultureInfo("id-ID"))</span></div><b>@item.Subtotal.ToString("C0",CultureInfo.GetCultureInfo("id-ID"))</b></div>}<div class="portal-total"><span>Total</span><strong>@o.TotalAmount.ToString("C0",CultureInfo.GetCultureInfo("id-ID"))</strong></div></section><section class="portal-card"><h2>Log status</h2><ol class="portal-timeline">@foreach(var log in Model.Logs){<li><span></span><div><strong>@OrderStatusWorkflow.Label(log.Status)</strong><time>@log.CreatedAt.ToString("dd MMM yyyy, HH:mm",CultureInfo.GetCultureInfo("id-ID"))</time>@if(!string.IsNullOrWhiteSpace(log.Note)){<p>@log.Note</p>}</div></li>}</ol></section></div><aside><section class="portal-card"><h2>Informasi</h2><dl class="portal-dl"><div><dt>Pembayaran</dt><dd>@(o.PaymentStatus=="unpaid"?"Belum dibayar":o.PaymentStatus)</dd></div><div><dt>Fulfillment</dt><dd>@(o.FulfillmentType=="pickup_delivery"?"Antar-jemput":"Drop off")</dd></div>@if(!string.IsNullOrWhiteSpace(o.FullAddress)){<div><dt>Alamat @o.AddressLabel</dt><dd>@o.FullAddress</dd></div>}@if(!string.IsNullOrWhiteSpace(o.Notes)){<div><dt>Catatan customer</dt><dd>@o.Notes</dd></div>}</dl></section><section class="portal-card"><h2>Perbarui status</h2>@if(Model.AllowedStatuses.Any()){<form class="portal-form" asp-action="UpdateOrderStatus" asp-route-id="@o.Id" method="post"><label>Status berikutnya<select name="status">@foreach(var s in Model.AllowedStatuses){<option value="@s">@OrderStatusWorkflow.Label(s)</option>}</select></label><label>Catatan<textarea name="notes" rows="4"></textarea></label><button type="submit">Simpan perubahan</button></form>}else{<p class="portal-muted">Tidak ada transisi valid yang tersedia.</p>}<p class="portal-note">Refund belum tersedia. Pesanan paid tidak dapat dibatalkan dari form ini.</p></section></aside></div>
