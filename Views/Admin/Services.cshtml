@model IReadOnlyList<MyKicksBuddy.Models.Dtos.ServiceAdminDto>
@using System.Globalization
@{Layout="_AdminLayout";ViewData["Title"]="Manajemen Layanan & Tarif";var id=CultureInfo.GetCultureInfo("id-ID");}
<header class="portal-page-head"><div><p class="portal-eyebrow">KATALOG OPERASIONAL</p><h1>Manajemen Layanan &amp; Tarif</h1><p>Kelola katalog servis, deskripsi, dan tarif dasar yang digunakan customer.</p></div><a class="portal-primary" asp-action="CreateService">+ Tambah Layanan</a></header>
@if(TempData["Success"] is string success){<div class="portal-alert is-success">@success</div>}
<section class="portal-stats admin-kpis"><article class="portal-stat"><span>LAYANAN AKTIF</span><strong>@ViewData["ActiveCount"]</strong><small>Tersedia di katalog</small></article><article class="portal-stat"><span>LAYANAN NONAKTIF</span><strong>@ViewData["InactiveCount"]</strong><small>Tidak dapat dipilih customer</small></article><article class="portal-stat"><span>RATA-RATA TARIF</span><strong>@(((decimal)ViewData["AveragePrice"]!).ToString("C0",id))</strong><small>Seluruh layanan tersimpan</small></article></section>
<form class="portal-filter" method="get"><label>Cari layanan<input name="search" value="@ViewData["Search"]" placeholder="Cari layanan sepatu..."/></label><label>Status layanan<select name="status"><option value="">Semua</option><option value="active" selected="@(ViewData["Status"]?.ToString()=="active")">Aktif</option><option value="inactive" selected="@(ViewData["Status"]?.ToString()=="inactive")">Nonaktif</option></select></label><button type="submit">Terapkan</button><a asp-action="Services">Reset</a></form>
<section class="portal-card portal-table-card"><div class="portal-card-head"><h2>Daftar Layanan</h2><span>@Model.Count hasil</span></div>@if(Model.Count==0){<div class="portal-empty"><h3>Belum ada layanan yang cocok</h3><p>Tambah layanan baru atau ubah filter pencarian.</p></div>}else{<div class="portal-table-wrap"><table><thead><tr><th>Nama Layanan</th><th>Deskripsi Layanan</th><th>Harga</th><th>Estimasi</th><th>Status Layanan</th><th>Aksi</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.Name</strong></td><td>@(s.Description??"—")</td><td><strong>@s.Price.ToString("C0",id)</strong></td><td>@(s.EstimatedDurationDays.HasValue?$"{s.EstimatedDurationDays} hari":"—")</td><td><span class="portal-chip @(s.IsActive?"is-status":"")">@(s.IsActive?"Aktif":"Nonaktif")</span></td><td><div class="portal-actions"><a class="portal-link" asp-action="EditService" asp-route-id="@s.Id">Edit</a><form asp-action="ToggleService" asp-route-id="@s.Id" method="post"><button class="portal-link-button" type="submit" name="operation" value="@(s.IsActive ? "deactivate" : "activate")">@(s.IsActive?"Nonaktifkan":"Aktifkan")</button></form></div></td></tr>}</tbody></table></div>}</section>
